# Database connection URL
RBAC_RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rbac_rag

# Component selection (registry name or "package.module:ClassName")
RBAC_RAG_CHUNKER=markdown
RBAC_RAG_EMBEDDER=gemini
RBAC_RAG_LLM=gemini
RBAC_RAG_ACL_FILTER=directory

# Chunking settings
RBAC_RAG_CHUNK_SIZE=800
RBAC_RAG_CHUNK_OVERLAP=120

# Search & Retrieval settings
RBAC_RAG_TOP_K=5
RBAC_RAG_HNSW_EF_SEARCH=200

# Embedding & Model settings
RBAC_RAG_EMBEDDING_DIM=768
RBAC_RAG_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RBAC_RAG_GEMINI_LLM_MODEL=gemini-2.5-flash
RBAC_RAG_GEMINI_JUDGE_MODEL=gemini-2.5-flash
RBAC_RAG_EMBED_BATCH_SIZE=16

# Google / Vertex AI authentication and project configuration
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
